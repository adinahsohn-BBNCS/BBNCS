# Copy to .env.deploy and fill in (never commit .env.deploy)
# BBNCS / bbncs.com ONLY — do not use Fly LRE credentials here
# Hosted on Hostinger: hPanel → Websites → bbncs.com → Files → FTP Accounts

SFTP_HOST=your_hostinger_ftp_ip
SFTP_PORT=21
SFTP_USER=your_hostinger_ftp_username
SFTP_PASSWORD=your_ftp_password
# The FTP account opens directly in public_html
FTP_REMOTE_DIR=/
