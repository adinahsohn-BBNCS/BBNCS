# Copy to .env.supabase — never commit .env.supabase
# Google OAuth (Web client "BBNCS Tickets" in Google Cloud Console)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_secret

# Optional; defaults to https://bbncs.com
SITE_URL=https://bbncs.com

# Ticket email (Resend — https://resend.com)
RESEND_API_KEY=re_your_api_key
NOTIFY_FROM_EMAIL=BBNCS Support <notify@bbncs.com>

# From https://supabase.com/dashboard/account/tokens after `npx supabase login`
# (or run login each session and omit this line)
SUPABASE_ACCESS_TOKEN=your_supabase_cli_token
