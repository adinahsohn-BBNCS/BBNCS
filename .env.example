# Copy to .env for local analytics / Search Console (optional — never commit real .env)
# Get GA4 ID from https://analytics.google.com → Admin → Data streams
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Get verification code from https://search.google.com/search-console → HTML tag method
PUBLIC_GSC_VERIFICATION=your_google_site_verification_code

# Support tickets (Supabase) — see docs/tickets-setup.md
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_key
